<turbo-frame id="input">
  <div class="practice_progress_bar">
    <%= "#{@practice_session.current + 1} / #{@practice_session.length}"%>
  </div>
  <div class="practice_form" 
    data-controller="practice"
    data-action="keydown->practice#ChangeAnswer">
    <%= form_with url: practice_answers_path(@practice_session.id) do |form| %>
      <% questions.each do |q| %>
        <%= render 'question_histories/single_question', form: form, question: q %>
      <% end %>
      <%= form.submit "Next", class: "answer_next button" %>
    <% end %>
  </div>
</turbo-frame>