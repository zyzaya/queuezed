<turbo-frame id="input">
  <div class="practice_progress_bar">
    <%= "#{@practice_session.current} / #{@practice_session.length}"%>
  </div>
  <div class="immediate_feedback">
    <% @question_histories.each do |h| %>
      <%= render 'question_histories/single_question_feedback', question_history: h, practice_session: @practice_session %>
    <% end %>
    <%= link_to 'Next', new_practice_answer_path(@practice_session.id), class: 'immediate_feedback_next button', autofocus: true %>
  </div>
</turbo-frame>