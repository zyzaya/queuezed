<div class="single_question_feedback">
  <h1 class="question_content">Q. <%= question_history.question.content %></h1>
  <div class="answer_feedback">
    <% question_history.answer_histories.each do |history| %>
      <div class="feedback_container <%= history.correct ? "correct" : "incorrect" %>">
        <input class="answer_input" id=<%= "given##{history.id}"%> type="text" value="<%= history.given %>" disabled>
        <div class="answer_symbol"><%= history.correct ? "✓" : "x" %></div>
        <% unless history.correct %>
          <input class="answer_input" id=<%= "expected##{history.id}"%> type="text" value="<%= history.expected %>" disabled>
        <% end %>
      </div>  
    <% end %>
  </div>
</div>