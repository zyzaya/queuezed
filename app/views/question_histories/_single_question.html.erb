<div class="practice_question">
  <h1 class="practice_question_content">Q. <%= question.content %></h1>
  <% question.answers.each_with_index do |answer, i| %>
    <div class="practice_question_answer_container">
      <%= form.text_field "given[#{question.id}][]",
        autocomplete: 'off', 
        class: "practice_question_answer_input", 
        data: {"practice-target": "input",
                action: "focus->practice#FocusAnswer"}%>
    </div>  
  <% end %>
</div>