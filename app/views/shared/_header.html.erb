<div class="header">
  <div class="flash">
    <% if flash[:notice] %>
      <p class="notice"><%= notice %></p>
    <% end %>
    <% if flash[:alert] %>
      <p class="alert"><%= alert %></p>
    <% end %>
  </div>
  <div class="header_info">
    <div></div>
    <%= link_to "queuezed", quizzes_path, class: "header_title" %>
    <div class="header_buttons">
      <button class="header_settings button">Settings</button>
      <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: 'button' %>
    </div>
  </div>
</div>
