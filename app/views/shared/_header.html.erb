<div class="header">
  <% if is_guest %>
    <div class="header_guest">
        You are currently not signed in, please sign in to save your changes.  
    </div>
  <% end %>
  <%= link_to "queuezed", quizzes_path, class: "header_title" %>
  <div class="header_buttons">
    <% if is_guest %>
      <%= link_to "Sign In", new_user_session_path, class: "button" %>
    <% else %>
      <%= link_to "Settings", edit_user_registration_path, class: "button"%>
      <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: 'button' %>
    <% end %>
  </div>  
</div>
