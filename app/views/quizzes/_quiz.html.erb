<div class="quiz">
  <div>
    <h2 class="title"><%= quiz.name %></h2>
    <%= link_to 'Delete', quiz, 
      class: 'quiz_delete',
      data: { 
        turbo_method: 'delete', 
        turbo_confirm: 'Are you sure you wish to permanently delete this quiz?'
      }
    %>
    <%= link_to 'Edit 🖉', edit_quiz_path(quiz), class: 'quiz_edit button' %>
  </div>
  <div>
    <h3 class="subtitle"><%= quiz.questions_count %> questions</h2>
  </div>
  <div>
    <%= link_to 'Practice', new_quiz_practice_path(quiz), class: 'quiz_practice button' %>
    <% unless difficult_count == 0 %>
      <%= button_to "Difficult (#{difficult_count})", quiz_practice_index_path(quiz), class: 'quiz_difficult button', params: { difficult_filter: 'true' } %>
    <% end %>
    <% unless review_count == 0 %>
      <%= button_to "Review (#{review_count})", quiz_practice_index_path(quiz), class: 'quiz_review button', params: { review_filter: 'true' }, disabled: (review_count == 0) %>
    <% end %>
  </div>
</div>