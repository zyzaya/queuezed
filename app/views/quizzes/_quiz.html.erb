<div class="quiz">
  <div>
    <h2 class="title"><%= quiz.name %></h2>
    <%= link_to 'Edit 🖉', edit_quiz_path(quiz), class: 'quiz_edit button' %>
    <%= link_to 'Delete', quiz, 
      data: { 
        turbo_method: 'delete', 
        turbo_confirm: 'Are you sure you wish to permanently delete this quiz?'} %>
  </div>
  <div>
    <h3 class="subtitle"><%= quiz.questions_count %> questions</h2>
  </div>
  <div>
    <%= link_to 'Practice', new_quiz_practice_path(quiz), class: 'quiz_practice button' %>
    <button class="quiz_difficult button">Difficult</button>
    <button class="quiz_review button">Review</button>
  </div>
</div>