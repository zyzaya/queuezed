<div class="quizzes_index">
  <%= render 'shared/header' %>
  <button class="quiz_new button">New Quiz</button>
  <div class="quizzes_container">
    <% @quizzes.each do |q| %>
      <%= render 'quizzes/quiz', quiz: q %>
    <% end %>
  </div>
</div>
<%= stylesheet_link_tag "quizzes/index", "data-turbo-track": "reload" %>