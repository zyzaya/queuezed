<div class="quizzes_edit" id="quizzes_edit" data-quiz_id= <%= @quiz.id %>>
  <%= render 'shared/header' %>
  <div class="edit" 
    data-controller="edit" 
    data-edit-quiz-id-value = <%= @quiz.id %>
    data-action="
      question:delete@window->edit#deleteQuestion
      single-question:load@window->edit#loadSingleQuestion
      single-question:questionContentChange@window->edit#questionContentChange
      single-question:addAnswer@window->edit#addAnswer
      answer:load@window->edit#loadAnswer
      answer:answerContentChange@window->edit#answerContentChange
      answer:delete@window->edit#deleteAnswer">
    <div class="quiz_info">
      <%= text_field "", "quiz_title", class: "quiz_title", value:"#{@quiz.name}", data: { action:'edit#quizTitleChange', 'edit-target': 'title' }%>
      <div class="question_count"><%= @quiz.questions.count %> questions</div>
    </div>
    <div class="toolbar">
      <a class="button" id="undo" data-action="edit#undo">undo</a>
      <a class="button" id="redo" data-action="edit#redo">redo</a>
      <a class="button" id="new_question" data-action="edit#newQuestion">new q</a>
      <a class="button" id="save" data-action="edit#save">save</a>
    </div>
    <div class="edit_frame">
      <div class="edit_question_list">
        <div class="quiz_tag_list">
          <% @quiz.tags.uniq.each do |t| %>
            <div class="button tag"><%= t.content %></div>
          <% end %>
        </div>
        <div id='gridjs' 
          data-controller="zgrid" 
          data-zgrid-quiz-id-value=<%= @quiz.id %> 
          data-zgrid-edit-outlet='.edit[data-controller=edit]'
          data-action=
            "edit:refresh@window->zgrid#refresh
            edit:selectQuestion@window->zgrid#select
            edit:selectSibling@window->zgrid#setSelectedToSibling"></div>
      </div>
      
      <turbo-frame id="edit_detail" >
        deeetail
      </turbo-frame>
    </div>
  </div>
</div>
<%= stylesheet_link_tag "zgrid_default", "data-turbo-track": "reload" %>
<%= stylesheet_link_tag "quizzes/zgrid", "data-turbo-track": "reload"%>
<%= stylesheet_link_tag "quizzes/edit", "data-turbo-track": "reload" %>