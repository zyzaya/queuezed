<div class="quizzes_edit">
  <%= render 'shared/header' %>
  <div class="edit">
    <div class="quiz_info">
      <h1 class="quiz_title"><%= @quiz.name %></h1>
      <div class="question_count"><%= @quiz.questions.count %> questions</div>
    </div>
    <div class="toolbar">
      <a class="button">undo</a>
      <a class="button">redo</a>
      <a class="button">new q</a>
      <a class="button">save</a>
    </div>
    <div class="edit_frame">
      <table class="question_list">
        <tr class="list_header">
          <th>Question</th>
          <th>Streak</th>
          <th>Best Streak</th>
        </tr>
        <% @quiz.questions.each do |q| %>
          <% link = "/quizzes/#{@quiz.id}/edit/questions/#{q.id}" %>
          <tr class="list_row">
            <td><%= link_to "#{q.content}", link, data: {"turbo-frame" => "edit_detail"} %></td>
            <td><%= link_to "#{q.current_streak.to_s}0", link, data: {"turbo-frame" => "edit_detail"} %></td>
            <td><%= link_to "#{q.longest_streak.to_s}0", link, data: {"turbo-frame" => "edit_detail"} %></td>
          </tr>
        <% end %>
      </table>
      <turbo-frame class="question_detail" id="edit_detail" >
        deeetail
      </turbo-frame>
    </div>
  </div>
</div>
<%= stylesheet_link_tag "quizzes/edit", "data-turbo-track": "reload" %>