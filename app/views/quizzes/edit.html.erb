<div class="quizzes_edit" id="quizzes_edit" data-quiz_id= <%= @quiz.id %>>
  <%= render 'shared/header' %>
  <div class="edit">
    <div class="quiz_info">
      <h1 class="quiz_title"><%= @quiz.name %></h1>
      <div class="question_count"><%= @quiz.questions.count %> questions</div>
    </div>
    <div class="toolbar">
      <a class="button" id="undo">undo</a>
      <a class="button" id="redo">redo</a>
      <a class="button" id="new_question">new q</a>
      <a class="button">save</a>
    </div>
    <div class="edit_frame">
      <table class="question_list" id="question_list">
        <tr class="list_header">
          <th>Question</th>
          <th>Streak</th>
          <th>Best Streak</th>
        </tr>
        <% @quiz.questions.each do |q| %>
          <tr class="list_row" data-question_id= <%= q.id %>>
            <td><%= "#{q.content}"%></td>
            <td><%= "#{q.current_streak}0"%></td>
            <td><%= "#{q.longest_streak}0"%></td>
          </tr>
        <% end %>
      </table>
      <turbo-frame class="question_detail" id="edit_detail" >
        deeetail
      </turbo-frame>
    </div>
  </div>
</div>
<%= stylesheet_link_tag "quizzes/edit", "data-turbo-track": "reload" %>
<%= javascript_import_module_tag "edit/edit" %>