<div class="quizzes_edit" id="quizzes_edit" data-quiz_id= <%= @quiz.id %>>
  <%= render 'shared/header' %>
  <div class="edit">
    <div class="quiz_info">
      <%= text_field "", "quiz_title", class: "quiz_title", value:"#{@quiz.name}"%>
      <div class="question_count"><%= @quiz.questions.count %> questions</div>
    </div>
    <div class="toolbar" data-controller="toolbar">
      <a class="button" id="undo" data-action="toolbar#undo">undo</a>
      <a class="button" id="redo" data-action="toolbar#redo">redo</a>
      <a class="button" id="new_question" data-action="toolbar#newQuestion">new q</a>
      <a class="button" id="save" data-action="toolbar#save">save</a>
    </div>
    <div class="edit_frame">
      <div id='gridjs'></div>
      <turbo-frame class="question_detail" id="edit_detail" >
        deeetail
      </turbo-frame>
    </div>
  </div>
</div>
<%= stylesheet_link_tag "zgrid_default", "data-turbo-track": "reload" %>
<%= stylesheet_link_tag "quizzes/zgrid", "data-turbo-track": "reload"%>
<%= stylesheet_link_tag "quizzes/edit", "data-turbo-track": "reload" %>
<%= javascript_import_module_tag "edit/edit" %>