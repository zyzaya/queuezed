<div class="quizzes_edit" id="quizzes_edit" data-quiz_id= <%= @quiz.id %>>
  <%= render 'shared/header' %>
  <div class="edit" 
    data-controller="edit" 
    data-edit-quiz-id-value = <%= @quiz.id %>
    data-edit-question-count-value = <%= @quiz.questions.count %>
    data-action="
      edit--zgrid:setTagCount@window->edit#setTagCount
      edit--zgrid:updateQuestionCount@window->edit#setQuestionCount
      edit--question:delete@window->edit#deleteQuestion
      edit--question:addTag@window->edit#addTag
      edit--question:removeTag@window->edit#removeTag
      edit--question:createTag@window->edit#createTag
      edit--question:addRelated@window->edit#addRelated
      edit--single-question:contentChange@window->edit#questionContentChange
      edit--single-question:addAnswer@window->edit#addAnswer
      edit--single-question:removeAsRelation@window->edit#removeRelation
      edit--answer:contentChange@window->edit#answerContentChange
      edit--answer:delete@window->edit#deleteAnswer
      beforeunload@window->edit#beforeunload
      keydown.ctrl+shift+s@window->edit#save
      keydown.ctrl+z@window->edit#undo
      keydown.ctrl+shift+z@window->edit#redo
      keydown.alt+q@window->edit#newQuestion">
    <div class="quiz_info">
      <%= text_field "", "quiz_title", class: "quiz_title", value:"#{@quiz.name}", data: { action:'edit#quizTitleChange', 'edit-target': 'title' }%>
      <div class="question_count" data-edit-target="subtitle"></div>
      <div class="practice_toolbar">
        <%= link_to 'Practice', new_quiz_practice_path(@quiz.id), class: 'quiz_practice button' %>
        <%= button_to 'Difficult', quiz_practice_index_path(@quiz), class: 'quiz_difficult button', params: { difficult_filter: 'true' }%>
        <%= button_to 'Review', quiz_practice_index_path(@quiz), class: 'quiz_review button', params: { review_filter: 'true' }%>
      </div>
    </div>
    <div class="toolbar">
      <a class="button" id="undo" data-action="edit#undo">undo</a>
      <a class="button" id="redo" data-action="edit#redo">redo</a>
      <a class="button" id="new_question" data-action="edit#newQuestion">new q</a>
      <a class="button" id="save" data-action="edit#save" data-edit-target="saveButton">save</a>
    </div>
    <div class="edit_frame">
      <div class="edit_list" 
          data-controller="edit--zgrid" 
          data-edit--zgrid-quiz-id-value=<%= @quiz.id %> 
          data-edit--zgrid-edit-outlet='.edit[data-controller=edit]'
          data-action=
            "edit:selectQuestion@window->edit--zgrid#select
            edit:selectSibling@window->edit--zgrid#setSelectedToSibling
            edit:addQuestion@window->edit--zgrid#addQuestion
            edit:deleteQuestion@window->edit--zgrid#deleteQuestion
            edit:addTag@window->edit--zgrid#addTag
            edit:removeTag@window->edit--zgrid#removeTag
            edit:questionContentChange@window->edit--zgrid#questionContentChange
            filter:updateFilter@window->edit--zgrid#updateFilter
            keydown.alt+n@window->edit--zgrid#nextQuestion
            keydown.alt+shift+n@window->edit--zgrid#previousQuestion
            resize@window->edit--zgrid#updateVisibleColumns">
        <%= render 'shared/filter', quiz: @quiz %>
        <div class="edit_displayed_count" data-edit--zgrid-target="questionCount"></div>
        <div class="edit_zgrid" data-edit--zgrid-target="zgridContainer"></div>
      </div>
      <%= render template: "questions/edit" %>
    </div>
  </div>
</div>
<%= stylesheet_link_tag "zgrid_default", "data-turbo-track": "reload" %>
<%= stylesheet_link_tag "quizzes/zgrid", "data-turbo-track": "reload"%>
<%= stylesheet_link_tag "quizzes/edit", "data-turbo-track": "reload" %>