<turbo-frame id="edit_detail">
  <div class="question_detail" data-controller="question" data-question-id-value = <%= @question.id %>>
    <div class="question_tags">
      <div>Tags</div>
      <input type="text" name="Create Tag" id="create_tag" hidden>
      <select class='add_tag' name='Add Tag'>
        <% @quiz.tags.order('content').uniq.each do |t| %>
          <option value=<%= t.id %>><%= t.content %></option>
        <% end %>
        <option disabled>------</option>
        <option value=-1>Create Tag</option>
      </select>
      <a class="button delete_question" 
        id="delete_question" 
        data-action="question#delete">Delete</a>
      <div class="tag_list">
        <% @question.tags.order('content').each do |t| %>
          <a class="button tag"><%= t.content %></a>
        <% end %>
      </div>
    </div>
    <hr>
    <%= render 'questions/single_question_edit', question: @question %>
    <hr>
    <div class="related_questions_header">Related Questions</div>
    <hr>
    <% @question.relations.each do |q| %>
      <%= render 'questions/single_question_edit', question: q %>
      <hr>
    <% end %>
  </div>
</turbo-frame>