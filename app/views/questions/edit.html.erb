<turbo-frame id="question_edit" class="question_edit">
  <div class="question_edit_detail question_edit_hidden"
    data-controller="edit--question" 
    data-action = 
      "edit--zgrid:setQuestion@window->edit--question#set
      edit--zgrid:updateFilteredQuestionList@window->edit--question#updateFilteredQuestionList
      edit--zgrid:updateQuestionList@window->edit--question#updateQuestionList
      keydown.alt+shift+q->edit--question#delete
      keydown.alt+t@window->edit--question#focusCreateTag"
    data-edit--question-id-value = "">
    <a class="button question_edit_delete" 
        id="delete_question" 
        data-action="edit--question#delete">Delete</a>
    <hr>
    <div class="question_edit_statistics">
      <div>Times Correct:</div>
      <div data-edit--question-target="correct">0 / 0</div>
      <div>Longest Streak:</div>
      <div data-edit--question-target="longestStreak">0</div>
      <div>Current Streak:</div>
      <div data-edit--question-target="currentStreak">0</div>
      <div>SRS Rank:</div>
      <div data-edit--question-target="rank">0</div>
      <div>Next Review</div>
      <div data-edit--question-target="review">0</div>
      <div>Difficult?</div>
      <div data-edit--question-target="difficult">no</div>
    </div>
    <div class="question_edit_tags">
      <hr>
      <div class="question_edit_tag_toolbar" >
        <label for="add_tag">Add Tag</label>
        <select class='add_tag' id='add_tag' name='Add Tag' 
          data-action="edit--question#addTag" 
          data-edit-target="tagOptionList">
          <option value="-1" selected>Select to add</option>
          <option value='-2' disabled>-----</option>
          <% @quiz.tags.order('content').uniq.each do |t| %>
            <option value=<%= t.id %> data-edit--question-target="tagOption"><%= t.content %></option>
          <% end %>
        </select>
        <label for="create_tag">Create Tag</label>
        <input type="text" name="Create Tag" id="create_tag" data-action="change->edit--question#createTag" data-edit--question-target="createTag">
      </div>
      <hr>
      <div class="question_edit_tag_list" 
        data-edit-target="tagList"
        data-edit--question-target="tagList">
      </div>
    </div>
    <hr data-edit--question-target="singleStart">
    <hr>
    <div class="question_edit_relations_header">Related Questions</div>
    <div class="question_edit_relations_toolbar">
      <label for="add_related">Add Relation</label>
      <select name="add_related" id="add_related" 
        data-edit--question-target="addRelatedList"
        data-action="edit--question#addRelated">
        <option value='-1' selected>Select to add</option>
        <option value='-2' disabled>-----</option>
        <% @quiz.questions.order(:content).each do |q| %>
          <option value=<%= q.id%> data-edit--question-target="addRelatedOption"><%= q.content%></option>
        <% end %>
      </select>
      <div>
        <label for="limit_add_related">Limit to shown questions</label>
        <input type="checkbox" name="limit_add_related" id="limit_add_related" data-edit--question-target="limitRelated" data-action="edit--question#enableRelatedLimit">
      </div>
    </div>
    <hr>
    <div class="question_edit_relations_container" data-edit--question-target="relationContainer" data-edit-target="relationContainer">
    </div>
  </div>
</turbo-frame>