<% answers = question.nil? ? [] : question.answers %>
<% id = question.nil? ? "" : question.id %>
<% content = question.nil? ? "" : question.content %>
<div class="single_question_edit" 
  data-controller='edit--single-question'
  data-action='edit:questionContentChange@window->edit--single-question#setContent'
  data-edit--single-question-edit--zgrid-outlet='.edit_list'
  data-edit-target='singleQuestionContainer'
  data-edit--question-target='singleQuestionContainer'
  data-edit--single-question-id-value='<%= id %>'>
  <div class="question_header">Question.</div>
  <textarea class="question_content" id=<%= "question_content##{id}"%>
    data-edit-target='questionContent'
    data-edit--single-question-id-value='<%= id %>'
    data-edit--single-question-target='info'
    data-action='change->edit--single-question#questionContentChange'><%= content %></textarea>
  <div class="answers_header">Answer(s).</div>
  <% answers.each do |answer| %>
    <div class="answer_container" 
      data-controller='edit--answer' 
      data-edit--answer-question-id-value='<%= id %>'
      data-edit--answer-id-value='<%= answer.id %>'
      data-edit--answer-edit--single-question-outlet='.single_question_edit[data-edit--single-question-id-value="<%= id %>"]'>
      <textarea class="answer_content" rows="1" 
        data-edit-target='answerContent'
        data-edit--answer-target='info' 
        data-action="edit--answer#answerContentChange"><%= answer.content %></textarea>
      <a class="button delete_answer" data-action="edit--answer#delete">[X]</a>
    </div>
  <% end %>
  <a class="button add_answer" data-action='edit--single-question#addAnswer'>Add Answer</a>
</div>