<div class="single_question_edit" >
  <div class="question_header">Question.</div>
  <textarea class="question_content" data-question_id=<%= question.id %>><%= question.content %></textarea>
  <div class="answers_header">Answer(s).</div>
  <% question.answers.each do |answer| %>
    <% variants = answer.answer_variants.pluck(:content) %>
    <div class="answer_container" 
      data-controller='answer' 
      data-answer-id-value='<%= answer.id %>'>
      <textarea class="answer_content" rows="1" data-answer-target='info' data-action="answer#answerContentChange"><%= variants.join(" / ") %></textarea>
      <a class="button delete_answer" data-answer_id=<%= answer.id %>>[X]</a>
    </div>
  <% end %>
  <a class="button add_answer" data-question_id=<%= question.id %>>Add Answer</a>
</div>