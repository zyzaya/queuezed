<div class="single_question_edit" 
  data-edit-target='singleQuestionContainer'
  data-controller='single-question'
  data-single-question-id-value='<%= question.id %>'>
  <div class="question_header">Question.</div>
  <textarea class="question_content" 
    data-single-question-id-value='<%= question.id %>'
    data-edit-target='questionContent'
    data-single-question-target='info'
    data-action='change->single-question#questionContentChange'><%= question.content %></textarea>
  <div class="answers_header">Answer(s).</div>
  <% question.answers.each do |answer| %>
    <div class="answer_container" 
      data-controller='answer' 
      data-answer-question-id-value='<%= question.id %>'
      data-answer-id-value='<%= answer.id %>'
      data-answer-single-question-outlet='.single_question_edit[data-single-question-id-value="<%= question.id %>"]'>
      <textarea class="answer_content" rows="1" 
        data-edit-target='answerContent'
        data-answer-target='info' 
        data-action="answer#answerContentChange"><%= answer.content %></textarea>
      <a class="button delete_answer" data-action="answer#delete">[X]</a>
    </div>
  <% end %>
  <a class="button add_answer" data-action='single-question#addAnswer'>Add Answer</a>
</div>