<div class="question">
  <h1 class="question_content">Q. <%= question.content %></h1>
  <% question.answers.each do |answer| %>
    <% 
      history = answer.answer_histories.find_by(practice_session_id: @practice_session.id)
      variants = answer.answer_variants.pluck(:content)
      correct = variants.include?(history.given)
    %>
    <div class="feedback_container <%= correct ? "correct" : "incorrect" %>">
      <input class="answer_input" type="text" value="<%= history.given %>" disabled>
      <div class="answer_symbol"><%= correct ? "✓" : "x" %></div>
      <% unless correct %>
        <input class="answer_input" type="text" value="<%= variants.join(" / ") %>" disabled>
      <% end %>
    </div>  
  <% end %>
</div>