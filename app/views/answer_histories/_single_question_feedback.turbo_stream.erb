<div class="question">
  <h1 class="practice_question_content">Q. <%= question.content %></h1>
  <% question.answers.each do |answer| %>
    <div class="practice_answer_container">
      <ol>
        <li><%= practice_session.answer_histories.find_by(answer_id: answer.id).given %></li>
        <li><%= answer.answer_variants.pluck(:content).join(" / ") %></li>
      </ol>
    </div>  
  <% end %>
</div>