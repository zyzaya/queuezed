<div class="question">
  <h1 class="practice_question_content">Q. <%= question.content %></h1>
  <% question.answers.each do |answer| %>
    <% 
      history = practice_session.answer_histories.find_by(answer_id: answer.id) 
      variants = answer.answer_variants.pluck(:content)
    %>
    <div class="practice_answer_feedback_container">
      <input class="practice_answer_input <%= variants.include?(history.given) ? "given_correct" : "given_incorrect" %>" type="text" value=<%= history.given %> disabled>
      <input class="practice_answer_input correct" type="text" value=<%= variants.join(" / ") %> disabled>
    </div>  
  <% end %>
</div>