<turbo-frame id="input">
  <%= render 'practice_sessions/progress', practice_session: @practice_session %>
  <div class="practice_form">
    <%= form_with url: "/quizzes/#{quiz.id}/practice/#{practice_session.id}/answers/new" do |form| %>
      <% questions.each do |q| %>
        <%= render 'answer_histories/single_question', form: form, question: q %>
      <% end %>
      <%= form.submit "Next", class: "answer_next button" %>
    <% end %>
  </div>
</turbo-frame>