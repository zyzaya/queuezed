<turbo-stream action="replace" target="input">
  <template>
    <div class="immediate_feedback" id="input">
      <% ([@current] + @current.relations).each do |r| %>
        <%= render 'answer_histories/single_question_feedback', question: r, practice_session: @practice_session %>
      <% end %>
      <%= link_to 'Next', "/quizzes/#{@quiz.id}/#{@practice_session.id}/answer_histories/new", class: 'immediate_feedback_next button' %>
    </div>
  </template>
</turbo-stream>