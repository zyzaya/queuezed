<div class="devise_info">
  <h1 class="devise_title">queuezed</h1>
  <div class="devise_form devise_forgot">
    <h2>Forgot your password?</h2>
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }, data: { turbo:false }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="devise_field">
        <%= f.label :email, class: "devise_label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "devise_text_input" %>
      </div>

      <div class="actions">
        <%= f.submit "Send me reset password instructions", class: "devise_submit button" %>
      </div>
    <% end %>

    <div class="devise_links ">
      <%= link_to "Log in", new_session_path(resource_name), data: { turbo:false }, class: 'devise_log_in' %>
      <%= link_to "Sign Up", new_registration_path(resource_name), data: { turbo: false}, class: 'devise_sign_up' %>
    </div>
  </div>
</div>

