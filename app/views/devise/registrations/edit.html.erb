<div class="devise_info registrations_edit">
  <%= render 'shared/header' %>
  <div class="devise_form">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }, data: { turbo:false }) do |f| %>
      <div class="devise_field">
        <%= f.label :current_password, class: "devise_label" %> <i>(we need your current password to apply your changes)</i>
        <%= f.password_field :current_password, autocomplete: "current-password", class: "devise_text_input" %>
        <%= render 'shared/error', resource: resource, attribute: :current_password%>
      </div>

      <div class="devise_field">
        <%= f.label :email, "New Email", class: "devise_label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "devise_text_input" %>
        <%= render 'shared/error', resource: resource, attribute: :email %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <div>Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
      <% end %>

      <div class="devise_field">
        <%= f.label :password, "New Password", class: "devise_label" %><i>(leave blank if you don't want to change it)</i>
        <%= f.password_field :password, autocomplete: "new-password", class: "devise_text_input" %>
        <% if @minimum_password_length %>
          <em><%= @minimum_password_length %> characters minimum</em>
        <% end %>
        <%= render 'shared/error', resource: resource, attribute: :password %>
      </div>

      <div class="devise_field">
        <%= f.label :password_confirmation, "New Password Confirmation", class: "devise_label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "devise_text_input" %>
        <%= render 'shared/error', resource: resource, attribute: :password_confirmation %>
      </div>

      <div class="devise_actions">
        <%= f.submit "Apply Changes", class: "devise_submit button" %>
      </div>
    <% end %>
    <hr>
    <div class="devise_delete">
      <h3>Delete my account</h3>
      <%= button_to "Delete my account", registration_path(resource_name), data: { turbo_confirm: "Are you sure you wish to delete your account?\nThis action cannot be undone." }, method: :delete, class: "button" %>
    </div>
  </div>
</div>