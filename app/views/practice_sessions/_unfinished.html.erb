<div class="unfinished">
  <div class="unfinished_header">
    <div class="progress"><%= "#{session.current} / #{session.length}"%></div>
    <%= link_to 'Continue', practice_path(session), class: "button" %>
  </div>
  <% unless session.text_filter.eql?("") %>
    <div class="textFilter">
      <span>Filter by text:</span><span><%= session.text_filter%></span>
    </div>
  <% end %>
  <% unless session.text_filter.eql?("") || session.tag_filter.eql?([]) %>
    <hr>
  <% end %>
  <% unless session.tag_filter.eql?([]) %>
    <div class="tagFilter">
      <div>Filter by tag:</div>
      <div class="tagContainer">
        <% session.tag_filter.each do |t| %>
          <span class="tag"><%= session.quiz.tags.find(t).content %></span>
        <% end %>
      </div>
    </div>
  <% end %>
</div>