<div class="practice_new">
  <%= render "shared/header"%>
  <%= render "shared/filter", quiz: @quiz %>
  <%= button_to 'Start', quiz_practice_index_path(@quiz.id), class: 'quiz_practice button', data: {turbo: false} %>
  <%= link_to 'Cancel', :back, class: 'button' %>
</div>
<%= stylesheet_link_tag "filter", "data-turbo-track": "reload" %>