<div class="quiz_practice">
  <%= render 'shared/header' %>
  <div class="quiz_practice_progress_bar"></div>
  <div class="quiz_practice_form">
    <%= form_with do |form| %>
      <h1 class="quiz_practice_question_content">Q. <%= @current.content %></h1>
      <% @current.answers.each do |answer| %>
        <div class="quiz_practice_answer_container">
          <%= form.label "#{answer.content}:", class: "quiz_practice_answer_content" %>
          <%= form.text_field "#{answer.content}", autocomplete: 'off', class: "quiz_practice_answer_input" %>
        </div>
      <% end %>
      <%= form.submit "Next", class: "quiz_practice_answer_next button" %>
    <% end %>
  </div>
</div>
