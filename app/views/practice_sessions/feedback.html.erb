<div class="practice">
 <%= render 'shared/header' %>
 <div class="feedback">
  <div class="quiz_info">
    <div class="quiz_title"><%= @quiz.name %></div>
    <div class="feedback_correct">
      <%= "#{@correct} / #{@total} or #{((@correct.to_f / @total.to_f) * 100).round(2)}%"%>
    </div>
  </div>
  <div class="feedback_info"> 
    <table class="question_list">
      <tr class="list_header">
        <th>Question</th>
        <th>Streak</th>
        <th>Best Streak</th>
      <tr>
      <% @questions.each do |q| %>
        <% link = "/quizzes/#{@quiz.id}/practice/#{@practice_session.id}/questions/#{q.id}"%>
        <tr class="list_row">
          <td><%= link_to "#{q.content}", link, data: {"turbo-frame" => "feedback_detail"} %></td>
          <td><%= link_to "#{q.current_streak.to_s}0", link, data: {"turbo-frame" => "feedback_detail"} %></td>
          <td><%= link_to "#{q.longest_streak.to_s}0", link, data: {"turbo-frame" => "feedback_detail"} %></td>
        </tr>
      <% end %>
    </table>
    <turbo-frame class="question_detail" id="feedback_detail" >
      deetail
    </turbo-frame>
  </div>
 </div>
</div>
<%= stylesheet_link_tag "practice_sessions/feedback", "data-turbo-track": "reload" %>