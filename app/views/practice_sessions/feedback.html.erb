<%= turbo_page_requires_reload %>
<div class="practice">
 <%= render 'shared/header' %>
 <div class="feedback">
  <div class="quiz_info">
    <div class="quiz_title"><%= @quiz.name %></div>
    <div class="feedback_correct">
      <%= "#{@correct} / #{@total} or #{((@correct.to_f / @total.to_f) * 100).round(2)}%"%>
    </div>
  </div>
  <div class="feedback_info"> 
    <div class="feedback_toolbar">
      <%= button_to "Retry", 
        quiz_practice_index_path(@quiz.id), 
        params: {text_filter: @practice_session.text_filter, tag_filter: @practice_session.tag_filter}, 
        data: {turbo: false},
        class: "button" %>
      <%= link_to "Home", "/", class: "button" %>
      <%= link_to "Edit", edit_quiz_path(@quiz.id), class: "button" %>
    </div>
    <div class="feedback_questions">
      <% @question_histories.each do |h| %>
        <%= render 'question_histories/single_question_feedback', question_history: h %>
      <% end %>
    </div>
  </div>
 </div>
</div>
<%= stylesheet_link_tag "practice_sessions/feedback", "data-turbo-track": "reload" %>