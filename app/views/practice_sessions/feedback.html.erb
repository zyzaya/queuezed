<div class="practice">
 <%= render 'shared/header' %>
 <%# <%= "You've completed #{@practice_session.length} questions from the quiz, \"#{@quiz.name}\"" %>
 <div class="feedback">
  <div class="feedback_quiz_info">
    <div class="feedback_quiz_title">Quiz Title</div>
    <div class="feedback_correct">x/y or n% correct</div>
  </div>
  <div class="feedback_info">
    <table class="feedback_list">
      <tr class="feedback_list_header">
        <th>Question</th>
        <th>Streak</th>
        <th>Best Streak</th>
      <tr>
      <% @practice_session.practice_questions.each do |pq| %>
        <tr class="feedback_list_row">
          <td><%= pq.question.content %></td>
          <td><%= pq.question.current_streak.to_s %></td>
          <td><%= pq.question.longest_streak.to_s %></td>
        </tr>
      <% end %>
    </table>
    <div class="feedback_detail">
      deetail
    </div>
  </div>
  
 </div>
</div>