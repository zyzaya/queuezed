<div class="practice">
 <%= render 'shared/header' %>
 <div class="feedback">
  <div class="quiz_info">
    <div class="quiz_title"><%= @quiz.name %></div>
    <div class="feedback_correct">
      <%= "#{@correct} / #{@total} or #{((@correct.to_f / @total.to_f) * 100).round(2)}%"%>
    </div>
  </div>
  <div class="feedback_info"> 
    <div class="feedback_filter">
      <label for="feedback_tag_filter">Filter by text</label>
      <input type="text" id="feedback_tag_filter">
      <label for="feedback_tag_filter">Filter by tag</label>
      <select name="" id="feedback_tag_filter">
        <option value="-1" selected>Select to add</option>
        <option value="-1" disabled>-----</option>
        <option value="correct" >Correct</option>
        <option value="incorrect">Incorrect</option>
        <option value="-1" disabled>-----</option>
      </select>
    </div>
    <div class="feedback_questions">
      <% @questions.each do |q|%>
        <%= render 'answer_histories/single_question_feedback', question: q %>
      <% end %>
    </div>
  </div>
 </div>
</div>
<%= stylesheet_link_tag "practice_sessions/feedback", "data-turbo-track": "reload" %>